{
  "name": "@turntable/worker",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "probe": "tsx scripts/probe.ts",
    "lint": "eslint src test scripts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude test/**/*.integration.spec.ts",
    "test:integration": "vitest run test --no-file-parallelism"
  },
  "dependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.29",
    "@turntable/observability": "workspace:*",
    "bullmq": "6.1.0",
    "ioredis": "6.0.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "testcontainers": "12.1.0",
    "tsx": "4.23.11",
    "vitest": "4.1.10"
  }
}
