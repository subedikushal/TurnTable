{
  "name": "@turntable/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src test scripts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude test/**/*.integration.spec.ts",
    "test:integration": "vitest run test --no-file-parallelism",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:compat": "tsx scripts/check-openapi-baseline.ts",
    "auth:dev-token": "tsx scripts/create-dev-token.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@fastify/static": "10.1.6",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@turntable/contracts": "workspace:*",
    "@turntable/observability": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@testcontainers/postgresql": "12.1.0",
    "@types/pg": "8.23.1",
    "testcontainers": "12.1.0",
    "tsx": "4.23.11",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
