  "info": {
    "title": "TurnTable API",
    "description": "TurnTable API-first modular monolith implementation contract",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "oidcBearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "OIDC access token"
      }
    },
    "schemas": {
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "display_name": {
            "type": "string",
            "example": "Alex Rivera"
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true
          }
        },
        "required": [
          "id",
          "display_name"
        ]
      },
      "MembershipSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "household_id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
              "MEMBER"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "LEFT",
              "REMOVED"
            ]
          }
        },
        "required": [
          "id",
          "household_id",
          "role",
          "status"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserDto"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembershipSummaryDto"
            }
          }
        },
        "required": [
          "user",
          "memberships"
        ]
      },
      "ProblemErrorDto": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ]
      },
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "example": "https://api.turntable.example/problems/validation-error"
          },
          "title": {
            "type": "string",
            "example": "Request validation failed"
          },
          "status": {
            "type": "number",
            "example": 422
          },
          "code": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "detail": {
            "type": "string"
          },
          "trace_id": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemErrorDto"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "trace_id"
        ]
      },
      "LiveHealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "ReadyChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "example": "up"
          },
          "migrations": {
            "type": "string",
            "example": "up"
          },
          "redis": {
            "type": "string",
            "example": "up"
          }
        },
        "required": [
          "database",
          "migrations",
          "redis"
        ]
      },
      "ReadyHealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "checks": {
            "$ref": "#/components/schemas/ReadyChecksDto"
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "BuildHealthDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "example": "0.0.0-local"
          },
          "commit": {
            "type": "string",
            "example": "unknown"
          },
          "runtime": {
            "type": "string",
            "example": "v24.14.0"
          },
          "environment": {
            "type": "string",
            "example": "local"
          }
        },
        "required": [
          "version",
          "commit",
          "runtime",
          "environment"
        ]
      },
      "CreateHouseholdRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Household Alpha"
          },
          "timezone": {
            "type": "string",
            "example": "America/New_York"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "example": "USD"
          }
        },
        "required": [
          "name",
          "timezone",
          "currency"
        ]
      },
      "HouseholdDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "example": "Household Alpha"
          },
          "timezone": {
            "type": "string",
            "example": "America/New_York"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "example": "USD"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "name",
          "timezone",
          "currency",
          "version"
        ]
      },
      "MembershipAccessDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "OWNER",
