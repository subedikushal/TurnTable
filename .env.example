APP_ENV=local
LOG_LEVEL=info
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
POSTGRES_PORT=5432
REDIS_PORT=6379
KEYCLOAK_PORT=8080
DATABASE_URL=postgresql://turntable:turntable@localhost:5432/turntable?schema=public
SHADOW_DATABASE_URL=postgresql://turntable:turntable@localhost:5432/turntable_shadow?schema=public
REDIS_URL=redis://localhost:6379

# Local OIDC is provided by the self-hosted Keycloak service in compose.yaml.
# Production/staging must use their public HTTPS Keycloak issuer and environment-specific audience.
AUTH_MODE=oidc
OIDC_ISSUER_URL=http://localhost:8080/realms/turntable
OIDC_AUDIENCE=urn:turntable:api:local
OIDC_SMOKE_CLIENT_ID=turntable-web
OIDC_SMOKE_REDIRECT_URI=http://localhost:3001/auth/callback
OIDC_SMOKE_API_URL=http://localhost:3000

# Strictly local defaults. Production/staging must inject distinct values from a secret manager.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=turntable-keycloak-admin-local-only
KEYCLOAK_DB_PASSWORD=turntable-keycloak-db-local-only
KEYCLOAK_WEB_CLIENT_SECRET=turntable-keycloak-web-local-only

# Optional local/test fallback: set AUTH_MODE=development to use an HS256 token.
# The API refuses development authentication outside APP_ENV=local/test.
DEV_AUTH_SECRET=replace-with-at-least-32-random-characters
INVITATION_TOKEN_SECRET=replace-with-a-distinct-32-character-random-secret

OTEL_SERVICE_NAME=turntable-api
OTEL_EXPORTER_OTLP_ENDPOINT=
BUILD_VERSION=0.0.0-local
BUILD_COMMIT=unknown
WORKER_CONCURRENCY=5
WORKER_PROBE_ON_START=false
