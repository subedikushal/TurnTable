APP_ENV=local
LOG_LEVEL=info
PORT=3000
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://turntable:turntable@localhost:5432/turntable?schema=public
SHADOW_DATABASE_URL=postgresql://turntable:turntable@localhost:5432/turntable_shadow?schema=public
REDIS_URL=redis://localhost:6379

# Production/staging: configure a standards-compliant OIDC issuer and audience.
AUTH_MODE=oidc
OIDC_ISSUER_URL=https://your-tenant.example.com/
OIDC_AUDIENCE=https://api.turntable.example

# Local/test only: set AUTH_MODE=development and use an HS256 token signed with this secret.
# The API refuses development authentication outside APP_ENV=local/test.
DEV_AUTH_SECRET=replace-with-at-least-32-random-characters

OTEL_SERVICE_NAME=turntable-api
OTEL_EXPORTER_OTLP_ENDPOINT=
BUILD_VERSION=0.0.0-local
BUILD_COMMIT=unknown
WORKER_CONCURRENCY=5
WORKER_PROBE_ON_START=false
