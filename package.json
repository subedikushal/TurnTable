{
  "name": "turntable",
  "version": "0.0.0",
  "private": true,
  "description": "API-first shared-household coordination platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "node --env-file=.env node_modules/turbo/bin/turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "db:generate": "prisma generate --config apps/api/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config apps/api/prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config apps/api/prisma.config.ts",
    "db:reset": "prisma migrate reset --config apps/api/prisma.config.ts",
    "db:seed": "tsx apps/api/prisma/seed.ts",
    "openapi:generate": "pnpm --filter @turntable/api openapi:generate && pnpm --filter @turntable/api-client generate",
    "openapi:check": "pnpm openapi:generate && pnpm --filter @turntable/api openapi:compat && git diff --exit-code -- docs/api/openapi.generated.json packages/api-client/src/generated/schema.d.ts",
    "postinstall": "pnpm db:generate"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "dotenv": "17.4.2",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "turbo": "2.10.8",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "typescript-eslint": "8.66.0"
  }
}
